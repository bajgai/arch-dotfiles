{{- $desktop := promptBoolOnce . "desktop" "Is this a desktop machine (Omarchy / Hyprland)" -}}
{{- $hostnick := promptStringOnce . "hostnick" "Short machine nickname (e.g. omarchy, vps)" -}}

sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
    desktop  = {{ $desktop }}
    hostnick = {{ $hostnick | quote }}
